# Локальные переменные для `wrangler dev`. Скопируйте в .dev.vars (файл в .gitignore).
# Реальные значения и прод-секреты сюда не писать.

# Не меньше 32 случайных байт; локально подойдёт любая строка 32+ символов.
# Пусто или короче 32 символов: регистрация и вход отвечают 503 auth_unavailable.
RATE_LIMIT_HMAC_KEY=

# Origin локального сервера. Перекрывает значение из wrangler.jsonc.
# Должен совпадать с адресом в браузере и заголовком Origin, иначе Worker отвечает 404/403.
CANONICAL_ORIGIN=http://127.0.0.1:8787

# RP_ID для WebAuthn: хост без схемы и порта.
RP_ID=127.0.0.1

# Не нужны при локальном запуске (только за прод-шлюзом); оставьте пустыми.
HUB_GATEWAY_ORIGIN=
HUB_GATEWAY_SECRET=

# Дашборд задач (/hub/apps/board.html): только владелец. Без обоих значений доступа нет.
# BOARD_OWNER_USERNAME: имя пользователя хаба владельца. BOARD_GITHUB_TOKEN: fine-grained токен, read-only Contents на agent-handoffs (секрет Worker, не в Git).
BOARD_OWNER_USERNAME=
BOARD_GITHUB_TOKEN=
