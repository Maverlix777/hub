{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kolobovdjp-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "hub.kolobovdjp.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "HUB_DB",
      "database_name": "hub-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CANONICAL_ORIGIN": "https://hub.kolobovdjp.org",
    "LEGACY_ORIGIN": "https://kolobovdjp.org",
    "RP_ID": "kolobovdjp.org",
    "RP_NAME": "KOLOBOVDJP Hub"
  }
}
